# LifeVault configuration.
#
# Copy to `.env` and edit. Every variable below is OPTIONAL -- config.py
# ships a working default for each one, so LifeVault runs with no `.env`
# file at all (in fixture mode, fully offline).
#
# See config.py for the authoritative defaults.

# --- Paths -----------------------------------------------------------------
# SQLite database. Created automatically on first run.
LIFEVAULT_DB_PATH=data/lifevault.db
# Where action tools (S7) are allowed to write their output files.
LIFEVAULT_VAULT_DIR=vault
LIFEVAULT_DEMO_DATA_DIR=demo-data

# --- Local models (Ollama) -------------------------------------------------
# Chat model. S3 measured llama3.2 (3B) on the dev laptop -- see README.
LIFEVAULT_MODEL_NAME=llama3.2
LIFEVAULT_EMBEDDING_MODEL_NAME=nomic-embed-text
# Single source of truth for vector width. Must match the embedding model:
# nomic-embed-text produces 768 dimensions. Changing this requires a re-index.
LIFEVAULT_EMBEDDING_DIM=768
LIFEVAULT_OLLAMA_HOST=http://localhost:11434

# --- Ingestion limits ------------------------------------------------------
LIFEVAULT_MAX_UPLOAD_SIZE_MB=50
LIFEVAULT_MAX_CHUNK_CHARS=2000

# --- Fixture mode ----------------------------------------------------------
# true  = no model calls at all; canned LLM output, fixture API responses.
#         This is the default, so a fresh clone runs with no Ollama installed.
# false = real local Ollama calls. Pull the two models above first.
LIFEVAULT_USE_FIXTURES=true

# --- Servers ---------------------------------------------------------------
LIFEVAULT_API_HOST=127.0.0.1
LIFEVAULT_API_PORT=8000
LIFEVAULT_UI_DEV_PORT=5173
LIFEVAULT_CORS_ORIGINS=http://localhost:5173

# --- Logging ---------------------------------------------------------------
LIFEVAULT_LOG_LEVEL=INFO
