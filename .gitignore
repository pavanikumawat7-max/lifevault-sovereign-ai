# --- Secrets / local config -------------------------------------------
.env

# --- Python -----------------------------------------------------------
.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# --- Runtime database (derived data; rebuild with scripts/index_folder.py)
# It also contains the full text of the user's documents and machine-specific
# absolute paths, so it must never be committed.
data/*.db
data/*.db-shm
data/*.db-wal

# --- Node / UI build --------------------------------------------------
# node_modules is platform-specific: a committed Windows install breaks the
# UI on macOS and Linux (@esbuild/win32-x64, @rollup/rollup-win32-*).
node_modules/
ui/dist/

# --- Vault: tool output (.ics reminders, .eml drafts) -----------------
# Generated by S7 tools at runtime, per-machine, never source.
vault/*
!vault/.gitkeep
